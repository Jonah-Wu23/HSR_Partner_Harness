# Desktop mode
PAIR_HARNESS_REAL=1

# Dialogue model. DeepSeek and OpenAI-compatible endpoints are supported.
PAIR_HARNESS_DIALOGUE_BASE_URL=https://api.deepseek.com
PAIR_HARNESS_DIALOGUE_API_KEY=replace-with-your-api-key
PAIR_HARNESS_DIALOGUE_MODEL=deepseek-chat

# Local Codex executable
PAIR_HARNESS_CODEX_BIN=codex

# DashScope voice
DASHSCOPE_API_KEY=replace-with-your-api-key
PAIR_HARNESS_DASHSCOPE_HOST=replace-with-your-workspace-id.cn-beijing.maas.aliyuncs.com
